    "db:seed": "tsx prisma/seed.ts",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:fonts": "node scripts/fetch-widget-fonts.mjs",
    "import:camara": "tsx scripts/import.ts camara",
