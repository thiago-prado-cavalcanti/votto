{
  "name": "votto",
  "version": "0.1.0",
  "private": true,
  "description": "Votto — direct-democracy platform measuring alignment between citizens and public agents.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx prisma/seed.ts --mode=admin",
    "db:seed:purge-demo": "tsx prisma/seed.ts --mode=purge-demo",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:fonts": "node scripts/fetch-widget-fonts.mjs",
    "assets:party-logos": "node scripts/build-party-logos.mjs",
    "check:sources": "tsx scripts/check-sources.ts",
    "check:cpf": "tsx scripts/check-cpf.ts",
    "check:cpf:contract": "tsx scripts/checks/infosimples-contract.ts",
    "backfill": "tsx scripts/backfill.ts",
    "reprioritize": "tsx scripts/reprioritize.ts",
    "summarize": "tsx scripts/sync.ts ai:summaries",
    "estimate:ai": "tsx scripts/estimate-ai-cost.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:all": "tsx scripts/sync.ts all",
    "worker": "tsx scripts/worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@prisma/client": "^6.18.0",
    "bcryptjs": "^3.0.2",
    "ioredis": "^5.9.0",
    "jose": "^6.1.0",
    "nanoid": "^5.1.7",
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "prisma": "^6.18.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
