{
  "name": "votto",
  "version": "0.1.0",
  "private": true,
  "description": "Votto — direct-democracy platform measuring alignment between citizens and public agents.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
