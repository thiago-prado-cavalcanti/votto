{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "server-only": [
        "./scripts/checks/stubs/server-only.ts"
      ],
      "next/headers": [
        "./scripts/checks/stubs/next/headers.ts"
      ]
    },
    "baseUrl": "../.."
  },
  "include": [
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "brand",
    "patch-humanizado"
  ]
}