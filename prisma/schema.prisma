// Votto data model.
// Conventions (see CLAUDE.md):
//   - All names in English.
//   - Internal `id` is NEVER exposed externally; externally-referenced entities
//     carry a `kid` (short public id). DTO mappers omit id/*Id (see src/lib/ids.ts).
//   - Citizen PII is minimized: only first/last name in clear; CPF is encrypted,
//     plus a deterministic HMAC (`cpfHash`) for dedup and a 6-digit clear prefix.
//   - Imported records are deduped idempotently by (source, externalRef).

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // "native" for local dev (macOS); the Debian target matches the node:20-slim
  // production Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AgentType {
  FEDERAL_DEPUTY
  STATE_DEPUTY
  COUNCILLOR
  SENATOR
  GOVERNOR
  MAYOR
  PRESIDENT
}

enum VoteValue {
  YES
  NO
  ABSTENTION
}

enum VoterType {
  USER
  AGENT
}

enum Scope {
  NATIONAL
  STATE
  MUNICIPAL
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum EntityStatus {
  ACTIVE
  BLOCKED
}

enum ImportSource {
  MANUAL
  CAMARA
  SENADO
}

/// Legislative house a theme originates from (federal scope, for now).
enum House {
  CAMARA
  SENADO
  CONGRESSO
}

// ─── Core entities ─────────────────────────────────────────────────────────

/// Political party. `kid` is the public identifier used in URLs/DTOs.
model Party {
  id          String       @id @default(cuid())
  kid         String       @unique
  name        String
  acronym     String?
  description String?
  logoUrl     String?
  status      EntityStatus @default(ACTIVE)

  // Denormalized counts for fast dashboards (kept in sync on writes/imports).
  agentCount  Int          @default(0)

  // Official metadata from the source (Câmara `partidos/{id}`, Senado
  // `composicao/lista/partidos`). `memberCount` is the house's own head count and
  // may legitimately differ from `agentCount` (which counts OUR records).
  leaderName  String?
  websiteUrl  String?
  memberCount Int?

  // Provenance for idempotent imports.
  source      ImportSource @default(MANUAL)
  externalRef String?

  agents      PublicAgent[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([source, externalRef])
  @@index([status])
}

/// Elected/public agent (deputy, councillor, senator, governor, etc.).
model PublicAgent {
  id           String       @id @default(cuid())
  kid          String       @unique
  firstName    String
  lastName     String
  email        String?
  phone        String?
  imageUrl     String?
  description  String?

  // CPF stored encrypted; HMAC for dedup; 6-digit clear prefix. Optional for agents
  // imported from public sources where CPF is not provided.
  cpfEncrypted String?
  cpfHash      String?      @unique
  cpfPrefix    String?

  type         AgentType
  state        String?
  municipality String?
  status       EntityStatus @default(ACTIVE)

  // Official profile page on the source (camara.leg.br / senado.leg.br).
  externalUrl  String?
  // False once the source stops listing the agent as sitting (mandate ended,
  // leave of absence, substitute stepped down). Kept instead of deleting so the
  // vote history — and therefore the alignment index — stays intact.
  inOffice     Boolean      @default(true)
  /// Legislature number the agent was last seen in (Câmara: 57 = 2023–2027).
  legislature  Int?

  partyId      String?
  party        Party?       @relation(fields: [partyId], references: [id])

  source       ImportSource @default(MANUAL)
  externalRef  String?

  votes        Vote[]
  proposedThemes    Theme[] @relation("ThemeProposer")
  rapporteuredThemes Theme[] @relation("ThemeRapporteur")

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([source, externalRef])
  @@index([type])
  @@index([state])
  @@index([status])
  @@index([partyId])
  @@index([inOffice])
}

/// A political theme (bill, amendment, law, etc.) citizens and agents vote on.
model Theme {
  id          String       @id @default(cuid())
  kid         String       @unique
  name        String
  summary     String       @default("")
  // Long-form explanation (≥2 paragraphs) shown on the theme detail page.
  description String       @default("")
  // Three perspectives on the theme: { right, center, left } (strings).
  viewpoints  Json?
  scope       Scope        @default(NATIONAL)
  state       String?
  municipality String?
  status      EntityStatus @default(ACTIVE)

  // Positioning dimensions: { economic: -1..1, social: -1..1, ... } weights used by
  // the political positioning index. Provisional model (CLAUDE.md §11).
  dimensions  Json?

  // ── Official legislative metadata (imported; null for manual themes) ───────
  /// Official short identifier, e.g. "PL 3085/2026".
  identifier  String?
  house       House?
  /// Public page for the bill on the source's own site.
  externalUrl String?
  /// Current procedural situation, verbatim from the source
  /// (Câmara `statusProposicao.descricaoSituacao`, Senado `situacaoAtual`).
  situation   String?
  /// Urgency/priority regime, verbatim from the source
  /// (Câmara `statusProposicao.regime`, e.g. "Urgência (Art. 155, RICD)").
  urgency     String?
  /// Normalized 0–100 priority rank derived from urgency + situation + recency.
  /// See `src/lib/domain/priority.ts`. Recomputed on every import.
  priority    Int          @default(0)
  /// Official subject classification:
  /// `[{ code, label, hierarchy?, relevance }]` — Câmara `proposicoes/{id}/temas`
  /// (`relevance` 1 = main subject) and Senado `processo.classificacoes`.
  classifications Json?
  /// Source-provided indexing keywords, used for search and AI enrichment.
  keywords    String?
  /// Whether the bill is still moving through the house (`tramitando`).
  inProgress  Boolean      @default(true)
  presentedAt DateTime?
  /// Timestamp of the last official action, used for recency ranking.
  lastActionAt DateTime?

  // ── Authorship (imported) ──────────────────────────────────────────────────
  /// The parliamentarian who proposed the bill, when the author is one.
  proposerId   String?
  proposer     PublicAgent? @relation("ThemeProposer", fields: [proposerId], references: [id])
  /// Author when it is not a sitting parliamentarian — a committee, the
  /// Executive, or the other house ("Presidência da República").
  proposerName String?
  /// The parliamentarian currently reporting on the bill. Shown when there is no
  /// parliamentarian proposer, since a relator is the next-best accountable face.
  rapporteurId String?
  rapporteur   PublicAgent? @relation("ThemeRapporteur", fields: [rapporteurId], references: [id])

  // ── AI-generated plain language (CLAUDE.md §4) ─────────────────────────────
  /// Short headline in plain Portuguese. The official `name`/`summary` are never
  /// overwritten — this is an additional, clearly-attributed layer.
  plainTitle   String?
  /// Two or three sentences explaining what the bill does and whom it affects.
  plainSummary String?
  /// Model that produced the fields above, for provenance and re-runs.
  aiModel      String?
  aiUpdatedAt  DateTime?
  /// Where `dimensions` came from: "AI" (generated) or "EDITOR" (human-set).
  /// An editor's tagging is never overwritten by a later AI pass.
  dimensionsSource String?

  // Denormalized vote tallies for fast "temperature" display.
  yesCount    Int          @default(0)
  noCount     Int          @default(0)
  absCount    Int          @default(0)

  source      ImportSource @default(MANUAL)
  externalRef String?

  articles    Article[]
  votes       Vote[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([source, externalRef])
  @@index([status])
  @@index([scope])
  @@index([priority])
  @@index([lastActionAt])
  @@index([inProgress])
  @@index([proposerId])
  @@index([rapporteurId])
}

/// Source article attached to a Theme. AI enrichment reads it to grow the summary.
model Article {
  id          String       @id @default(cuid())
  kid         String       @unique
  title       String?
  originalUrl String
  downloadUrl String?

  themeId     String
  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)

  source      ImportSource @default(MANUAL)
  externalRef String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([source, externalRef])
  @@index([themeId])
}

/// A vote on a Theme by either a citizen (User) or a PublicAgent.
/// One vote per CPF per Theme is enforced via @@unique([cpfHash, themeId]).
model Vote {
  id          String       @id @default(cuid())
  value       VoteValue
  voterType   VoterType

  themeId     String
  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)

  // Citizen vote: linked by user + cpfHash (no plaintext CPF).
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  cpfHash     String?

  // Agent vote.
  agentId     String?
  agent       PublicAgent? @relation(fields: [agentId], references: [id])

  /// When the roll call actually happened (agent votes only). Distinct from
  /// `createdAt`, which is when WE imported it.
  occurredAt  DateTime?
  /// Source identifier of the roll call this vote belongs to (Câmara votação id,
  /// Senado `codigoSessaoVotacao`). Internal only — never exposed (CLAUDE.md §5).
  sessionRef  String?

  source      ImportSource @default(MANUAL)
  externalRef String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // One citizen vote per CPF per theme.
  @@unique([cpfHash, themeId])
  // One agent vote per theme.
  @@unique([agentId, themeId])
  @@unique([source, externalRef])
  @@index([themeId])
  @@index([userId])
  @@index([agentId])
}

/// Citizen / voter. Minimal PII: only first/last name in clear (CLAUDE.md §5).
model User {
  id           String   @id @default(cuid())
  kid          String   @unique
  firstName    String
  lastName     String

  cpfEncrypted String
  cpfHash      String   @unique
  cpfPrefix    String

  // Bumped on each vote to invalidate cached alignment indexes.
  voteVersion  Int      @default(0)

  votes        Vote[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Backend administrator (separate auth from citizens).
model Administrator {
  id           String       @id @default(cuid())
  kid          String       @unique
  firstName    String
  lastName     String
  email        String       @unique
  mobile       String?
  passwordHash String
  role         AdminRole    @default(EDITOR)
  imageUrl     String?
  status       EntityStatus @default(ACTIVE)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
}

/// History log: one row per import execution, successful or not.
model ImportRun {
  id          String       @id @default(cuid())
  source      ImportSource
  /// Registered job name that produced this run, e.g. "camara:votes"
  /// (null for legacy/ad-hoc runs).
  job         String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  itemsSeen   Int          @default(0)
  itemsUpserted Int        @default(0)
  ok          Boolean      @default(false)
  note        String?

  @@index([source])
  @@index([job, startedAt])
}

/// Current state of one scheduled sync job. Doubles as a single-flight lock so
/// two worker instances (or a worker plus a manual trigger) never run the same
/// job concurrently: a run claims the job by setting `runningSince`, and a stale
/// claim older than the lease is reclaimable (see `src/lib/integration/runner.ts`).
model SyncJob {
  id             String    @id @default(cuid())
  /// Registered job name, e.g. "camara:agents".
  name           String    @unique
  /// Set while a run holds the lock; null when idle.
  runningSince   DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastOk         Boolean   @default(false)
  lastNote       String?
  lastItemsSeen  Int       @default(0)
  lastItemsUpserted Int    @default(0)
  /// Resume cursor for incremental jobs (e.g. the last synced date).
  watermark      String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
