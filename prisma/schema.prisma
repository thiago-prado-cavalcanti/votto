// Votto data model.
// Conventions (see CLAUDE.md):
//   - All names in English.
//   - Internal `id` is NEVER exposed externally; externally-referenced entities
//     carry a `kid` (short public id). DTO mappers omit id/*Id (see src/lib/ids.ts).
//   - Citizen PII is minimized: only first/last name in clear; CPF is encrypted,
//     plus a deterministic HMAC (`cpfHash`) for dedup and a 6-digit clear prefix.
//   - Imported records are deduped idempotently by (source, externalRef).

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  // "native" for local dev (macOS); the Debian target matches the node:20-slim
  // production Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AgentType {
  FEDERAL_DEPUTY
  STATE_DEPUTY
  COUNCILLOR
  SENATOR
  GOVERNOR
  MAYOR
  PRESIDENT
}

enum VoteValue {
  YES
  NO
  ABSTENTION
}

enum VoterType {
  USER
  AGENT
}

/// Identity providers a citizen may sign in with.
///
/// There is no INSTAGRAM member on purpose. Meta retired the Instagram Basic
/// Display API on 2024-12-04, and what replaced it ("Instagram API with
/// Instagram Login") only serves Business/Creator accounts and returns a
/// username — no person. The Instagram button therefore runs the Facebook
/// Login flow and lands here as FACEBOOK, which is also what keeps a citizen
/// who uses both buttons from ending up with two accounts.
enum SocialProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum Scope {
  NATIONAL
  STATE
  MUNICIPAL
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum EntityStatus {
  ACTIVE
  BLOCKED
}

enum ImportSource {
  MANUAL
  CAMARA
  SENADO
}

/// Legislative house a theme originates from (federal scope, for now).
enum House {
  CAMARA
  SENADO
  CONGRESSO
}

/// A stretch of an agent's mandate, as the house itself published it.
///
/// EXERCISE is time in the seat; LEAVE is an officially recorded absence
/// (Senado `licencas`, Câmara "Saída - Afastamento…"). The attendance pillar
/// subtracts LEAVE from EXERCISE, because a deputy licensed to serve as a state
/// secretary should not be marked absent from votes held while they were
/// legitimately away.
enum ServiceKind {
  EXERCISE
  LEAVE
}

// ─── Core entities ─────────────────────────────────────────────────────────

/// Political party. `kid` is the public identifier used in URLs/DTOs.
model Party {
  id          String       @id @default(cuid())
  kid         String       @unique
  name        String
  acronym     String?
  description String?
  logoUrl     String?
  status      EntityStatus @default(ACTIVE)

  // Denormalized counts for fast dashboards (kept in sync on writes/imports).
  agentCount Int @default(0)

  // Official metadata from the source (Câmara `partidos/{id}`, Senado
  // `composicao/lista/partidos`). `memberCount` is the house's own head count and
  // may legitimately differ from `agentCount` (which counts OUR records).
  leaderName  String?
  websiteUrl  String?
  memberCount Int?

  // ── Posicionamento agregado (CLAUDE.md §3.2) ───────────────────────────────
  /// Leitura do partido em cada eixo, −100..100, encolhida em direção à média
  /// da casa (`src/lib/indexes/pooling.ts`) e limitada a um erro padrão de
  /// deslocamento. NUNCA a média crua: uma bancada de um publicaria a
  /// excentricidade de uma pessoa como a posição de um partido.
  positionEconomic   Int?
  positionSocial     Int?
  /// Média observada antes de encolher, confiabilidade, dispersão interna, a
  /// tira de membros e a coesão em excesso sobre o acaso.
  positionDetail     Json?
  positionComputedAt DateTime?
  /// Coesão em excesso sobre o acaso (0–100), pelo índice de concordância de
  /// Hix, Noury & Roland corrigido pelo tamanho da bancada. NULL para bancada
  /// de um, onde a coesão é 1 por construção e não informa nada.
  cohesion           Int?

  // Provenance for idempotent imports.
  source      ImportSource @default(MANUAL)
  externalRef String?

  /// Accent- and case-folded haystack for the public search box, maintained by
  /// Postgres as a `GENERATED ... STORED` column — see
  /// `docs/migrations/0010_search.sql` for the expression and
  /// `src/lib/domain/search.ts` for its JavaScript mirror.
  ///
  /// NEVER write this field from application code: Postgres rejects any INSERT
  /// or UPDATE that supplies a value for a generated column. It is optional here
  /// only so Prisma leaves it out of every write.
  ///
  /// Covers `acronym` + `name`, so an agents search for `pt` or `uniao` reaches
  /// the bench through the relation.
  searchText String?

  agents PublicAgent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Elected/public agent (deputy, councillor, senator, governor, etc.).
model PublicAgent {
  id          String  @id @default(cuid())
  kid         String  @unique
  firstName   String
  lastName    String
  email       String?
  phone       String?
  imageUrl    String?
  description String?

  // CPF stored encrypted; HMAC for dedup; 6-digit clear prefix. Optional for agents
  // imported from public sources where CPF is not provided.
  cpfEncrypted String?
  cpfHash      String? @unique
  cpfPrefix    String?

  type         AgentType
  state        String?
  municipality String?
  status       EntityStatus @default(ACTIVE)

  // Official profile page on the source (camara.leg.br / senado.leg.br).
  externalUrl String?
  // False once the source stops listing the agent as sitting (mandate ended,
  // leave of absence, substitute stepped down). Kept instead of deleting so the
  // vote history — and therefore the alignment index — stays intact.
  inOffice    Boolean @default(true)
  /// Legislature number the agent was last seen in (Câmara: 57 = 2023–2027).
  legislature Int?

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  source      ImportSource @default(MANUAL)
  externalRef String?

  // ── Quality index (CLAUDE.md §3.3) ─────────────────────────────────────────
  /// Normalized 0–100 quality rank: attendance, authorship, rapporteurship and
  /// mandate running cost, each ranked against the agent's peers and combined by
  /// weight. Denormalized here (rather than derived per request) so lists can
  /// order in SQL — the same trade-off as `Theme.priority`.
  ///
  /// NULL, never 0, when the measured pillars do not cover enough of the index
  /// (`MIN_COVERAGE` in `src/lib/indexes/quality.ts`). The score is published,
  /// so an agent we cannot measure must show no reading at all: a zero would
  /// read as an accusation rather than as missing data.
  qualityScore      Int?
  /// The pillar breakdown behind `qualityScore`, always displayed beside it:
  /// `[{ key, label, score, weight, reading }]`. Kept as JSON because the pillar
  /// set is a registry meant to grow (CLAUDE.md §3.3) — a fifth factor must not
  /// cost a migration. No pillar is ever ordered by in SQL.
  qualityPillars    Json?
  qualityComputedAt DateTime?

  // ── Posicionamento (CLAUDE.md §3.2) ────────────────────────────────────────
  /// Leitura do eixo econômico (Estado − / Mercado +), −100..100.
  ///
  /// NULL, nunca 0, quando a cobertura de temas classificados não alcança o
  /// piso (`MIN_EFFECTIVE_ITEMS` em `src/lib/indexes/positioning.ts`). Zero é a
  /// coordenada de um centrista perfeito, então publicar zero por falta de dado
  /// é publicar uma posição que ninguém mediu — foi exatamente isso que colocou
  /// partidos de posição incontroversa no centro.
  positionEconomic   Int?
  /// Leitura do eixo social (Ordem − / Liberdades +), −100..100. Mesma regra.
  positionSocial     Int?
  /// O que sustenta as duas leituras: erro padrão e cobertura por eixo, a
  /// proposição de maior influência, a fatia de tags no formato antigo e as
  /// portas de faixa. Guardado como JSON porque é diagnóstico — nada aqui é
  /// ordenado em SQL.
  positionDetail     Json?
  positionComputedAt DateTime?

  /// Governismo (0–100): fatia das votações em que o agente votou com a
  /// orientação do bloco `Governo`.
  ///
  /// É o controle do índice de posicionamento antes de ser uma leitura: a
  /// primeira dimensão das votações nominais brasileiras é governo↔oposição, e
  /// sem medi-la não há como afirmar que o eixo econômico não é ela com outro
  /// nome (Zucco & Lauderdale 2011). NULL quando a casa não publica orientação.
  governismo Int?

  /// Denominador do governismo: votações com orientação do bloco `Governo` em
  /// que o agente esteve presente.
  ///
  /// Guardado porque a leitura não pode ser publicada sem ele. "78%" e "78% de
  /// 312 votações" são afirmações diferentes, e a segunda é a única conferível —
  /// a mesma disciplina que a performance política já segue ao imprimir
  /// "92% · 312 de 340 votações" ao lado da barra.
  governismoBase Int?

  /// Accent- and case-folded haystack for the public search box, maintained by
  /// Postgres as a `GENERATED ... STORED` column — see
  /// `docs/migrations/0010_search.sql` for the expression and
  /// `src/lib/domain/search.ts` for its JavaScript mirror.
  ///
  /// NEVER write this field from application code: Postgres rejects any INSERT
  /// or UPDATE that supplies a value for a generated column. It is optional here
  /// only so Prisma leaves it out of every write.
  ///
  /// Covers `firstName` + `lastName`. The party is NOT copied in — a generated
  /// column can only see its own row — so the agents search also matches
  /// `Party.searchText` through the relation, which is what keeps a party
  /// rename from needing a cascade.
  searchText String?

  votes              Vote[]
  proposedThemes     Theme[]        @relation("ThemeProposer")
  rapporteuredThemes Theme[]        @relation("ThemeRapporteur")
  rollCallVotes      RollCallVote[]
  presidedRollCalls  RollCall[]     @relation("RollCallPresiding")
  service            AgentService[]
  metrics            AgentMetrics[]
  followers          AgentFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([type])
  @@index([state])
  @@index([status])
  @@index([partyId])
  @@index([inOffice])
  @@index([qualityScore])
  @@index([positionEconomic])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// A political theme (bill, amendment, law, etc.) citizens and agents vote on.
model Theme {
  id           String       @id @default(cuid())
  kid          String       @unique
  name         String
  summary      String       @default("")
  // Long-form explanation (≥2 paragraphs) shown on the theme detail page.
  description  String       @default("")
  // Three perspectives on the theme: { right, center, left } (strings).
  viewpoints   Json?
  scope        Scope        @default(NATIONAL)
  state        String?
  municipality String?
  status       EntityStatus @default(ACTIVE)

  // Positioning dimensions: { economic: -1..1, social: -1..1, ... } weights used by
  // the political positioning index. Provisional model (CLAUDE.md §11).
  dimensions Json?

  // ── Official legislative metadata (imported; null for manual themes) ───────
  /// Official short identifier, e.g. "PL 3085/2026".
  identifier      String?
  house           House?
  /// Public page for the bill on the source's own site.
  externalUrl     String?
  /// Current procedural situation, verbatim from the source
  /// (Câmara `statusProposicao.descricaoSituacao`, Senado `situacaoAtual`).
  situation       String?
  /// Urgency/priority regime, verbatim from the source
  /// (Câmara `statusProposicao.regime`, e.g. "Urgência (Art. 155, RICD)").
  urgency         String?
  /// Normalized 0–100 priority rank derived from urgency + situation + recency.
  /// See `src/lib/domain/priority.ts`. Recomputed on every import.
  priority        Int       @default(0)
  /// Official subject classification:
  /// `[{ code, label, hierarchy?, relevance }]` — Câmara `proposicoes/{id}/temas`
  /// (`relevance` 1 = main subject) and Senado `processo.classificacoes`.
  classifications Json?
  /// Source-provided indexing keywords, used for search and AI enrichment.
  keywords        String?
  /// Whether the bill is still moving through the house (`tramitando`).
  inProgress      Boolean   @default(true)
  presentedAt     DateTime?
  /// Timestamp of the last official action, used for recency ranking.
  lastActionAt    DateTime?

  // ── Authorship (imported) ──────────────────────────────────────────────────
  /// The parliamentarian who proposed the bill, when the author is one.
  proposerId   String?
  proposer     PublicAgent? @relation("ThemeProposer", fields: [proposerId], references: [id])
  /// Author when it is not a sitting parliamentarian — a committee, the
  /// Executive, or the other house ("Presidência da República").
  proposerName String?
  /// The parliamentarian currently reporting on the bill. Shown when there is no
  /// parliamentarian proposer, since a relator is the next-best accountable face.
  rapporteurId String?
  rapporteur   PublicAgent? @relation("ThemeRapporteur", fields: [rapporteurId], references: [id])

  // ── AI-generated plain language (CLAUDE.md §4) ─────────────────────────────
  /// Short headline in plain Portuguese. The official `name`/`summary` are never
  /// overwritten — this is an additional, clearly-attributed layer.
  plainTitle       String?
  /// Two or three sentences explaining what the bill does and whom it affects.
  plainSummary     String?
  /// Model that produced the fields above, for provenance and re-runs.
  aiModel          String?
  aiUpdatedAt      DateTime?
  /// Where `dimensions` came from: "AI" (generated) or "EDITOR" (human-set).
  /// An editor's tagging is never overwritten by a later AI pass.
  dimensionsSource String?

  /// Accent- and case-folded haystack for the public search box, maintained by
  /// Postgres as a `GENERATED ... STORED` column — see
  /// `docs/migrations/0010_search.sql` for the expression and
  /// `src/lib/domain/search.ts` for its JavaScript mirror.
  ///
  /// NEVER write this field from application code: Postgres rejects any INSERT
  /// or UPDATE that supplies a value for a generated column. It is optional here
  /// only so Prisma leaves it out of every write.
  ///
  /// Covers `name` + `plainTitle` + `identifier` (the identifier twice: as
  /// written and with its punctuation stripped, so `PL 3085/2026`, `3085/2026`
  /// and `pl30852026` all find the same bill).
  searchText String?

  // Denormalized vote tallies for fast "temperature" display.
  yesCount Int @default(0)
  noCount  Int @default(0)
  absCount Int @default(0)

  source      ImportSource @default(MANUAL)
  externalRef String?

  articles  Article[]
  votes     Vote[]
  rollCalls RollCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([status])
  @@index([scope])
  @@index([priority])
  @@index([lastActionAt])
  @@index([inProgress])
  @@index([proposerId])
  @@index([rapporteurId])
  // Trigram index: what turns the search box's `LIKE '%…%'` into an index scan.
  // Needs the pg_trgm extension, created by the same migration.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Source article attached to a Theme. AI enrichment reads it to grow the summary.
model Article {
  id          String  @id @default(cuid())
  kid         String  @unique
  title       String?
  originalUrl String
  downloadUrl String?

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  source      ImportSource @default(MANUAL)
  externalRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([themeId])
}

/// A vote on a Theme by either a citizen (User) or a PublicAgent.
/// One vote per CPF per Theme is enforced via @@unique([cpfHash, themeId]).
model Vote {
  id        String    @id @default(cuid())
  value     VoteValue
  voterType VoterType

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)

  // Citizen vote: linked by user + cpfHash (no plaintext CPF).
  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  cpfHash String?

  // Agent vote.
  agentId String?
  agent   PublicAgent? @relation(fields: [agentId], references: [id])

  /// When the roll call actually happened (agent votes only). Distinct from
  /// `createdAt`, which is when WE imported it.
  occurredAt DateTime?
  /// Source identifier of the roll call this vote belongs to (Câmara votação id,
  /// Senado `codigoSessaoVotacao`). Internal only — never exposed (CLAUDE.md §5).
  sessionRef String?

  source      ImportSource @default(MANUAL)
  externalRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One citizen vote per CPF per theme.
  @@unique([cpfHash, themeId])
  // One agent vote per theme.
  @@unique([agentId, themeId])
  @@unique([source, externalRef])
  @@index([themeId])
  @@index([userId])
  @@index([agentId])
}

// ─── Quality index inputs (CLAUDE.md §3.3) ─────────────────────────────────

/// One nominal roll call held by a house — the attendance ledger.
///
/// This exists separately from `Vote` because `Vote` answers a different
/// question. `Vote` is unique on `(agentId, themeId)` and `upsertAgentVote`
/// rewrites the row when a later roll call touches the same bill, so it holds
/// the agent's STANDING POSITION on a theme — by design, since that is what the
/// alignment index consumes. Two roll calls on one bill collapse into one row
/// there, which makes it structurally unable to answer "how many sittings did
/// this agent show up to". Relaxing `Vote`'s unique key would break alignment to
/// fix attendance; a ledger of its own breaks nothing.
///
/// Written by the existing vote jobs from the responses they already download —
/// no extra request. Internal only: no `kid`, never exposed (CLAUDE.md §5).
model RollCall {
  id         String   @id @default(cuid())
  house      House
  occurredAt DateTime

  /// The bill voted on, when it resolves to a theme we imported. Nullable
  /// because attendance counts the sitting whether or not we track the bill.
  themeId String?
  theme   Theme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)

  /// Whoever was in the chair for this vote, when the source names them.
  ///
  /// Both houses forbid the presiding officer from voting in an open ballot and
  /// mark them with a code of their own — Câmara `"Artigo 17"`, Senado
  /// `"Presidente (art. 51 RISF)"`. That is not a position, so `mapVote` drops
  /// it; but the person was *in the room*, so dropping it from attendance too
  /// would count presiding as absence. Recorded here so the quality index can
  /// take the sitting out of that agent's denominator, the same way an official
  /// leave is taken out.
  presidingAgentId String?
  presiding        PublicAgent? @relation("RollCallPresiding", fields: [presidingAgentId], references: [id], onDelete: SetNull)

  /// Descrição da votação como a casa a publica — "Requerimento de urgência
  /// para o PL 1234/2024", "Votação em globo dos destaques", e assim por diante.
  ///
  /// É o único campo que separa MÉRITO de RITO, e a distinção decide se a
  /// votação entra no índice de posicionamento: uma votação de requerimento é
  /// posição sobre o andamento, não sobre o conteúdo, e o andamento se decide
  /// pela linha governo↔oposição quase por definição. `Theme.identifier` não
  /// resolve porque `proposicoesAfetadas` aponta para o projeto de fundo — uma
  /// urgência sobre o PL X vira posição sobre "PL X".
  ///
  /// Vem de graça: já está na resposta de lista que `syncVotes` baixa.
  description String?

  /// Orientação do bloco `Governo` nesta votação, quando a casa a publica
  /// (Câmara `/votacoes/{id}/orientacoes`). NULL significa "não publicada", que
  /// é diferente de "o governo liberou a bancada" — `Liberado` também vira
  /// NULL, e as duas coisas juntas apenas dizem que a votação não pode ser
  /// usada para medir contaminação governista.
  governmentPosition VoteValue?
  /// A mesma coisa para o bloco `Oposição`. As duas juntas é que dizem se a
  /// votação foi decidida ao longo da linha governo↔oposição: quando ambas
  /// orientam igual, essa linha não estava cortando.
  oppositionPosition VoteValue?

  source      ImportSource
  /// Câmara `votacao.id`, Senado `codigoSessaoVotacao`. Internal only.
  externalRef String

  votes RollCallVote[]

  createdAt DateTime @default(now())

  @@unique([source, externalRef])
  @@index([house, occurredAt])
  @@index([themeId])
  @@index([presidingAgentId])
}

/// One agent's participation in one roll call. Presence, not position.
model RollCallVote {
  id String @id @default(cuid())

  rollCallId String
  rollCall   RollCall @relation(fields: [rollCallId], references: [id], onDelete: Cascade)

  agentId String
  agent   PublicAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  value VoteValue

  @@unique([rollCallId, agentId])
  @@index([agentId])
}

/// A stretch of an agent's mandate, as the house published it.
///
/// The denominator of the attendance pillar: roll calls held while the agent was
/// in EXERCISE, minus those falling inside a LEAVE. Both houses publish this,
/// in different shapes — the Senado as explicit intervals
/// (`/senador/{cod}/licencas`), the Câmara as an event log
/// (`/deputados/{id}/historico`) that has to be paired into intervals.
model AgentService {
  id String @id @default(cuid())

  agentId String
  agent   PublicAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  startsAt DateTime
  /// Null while the stretch is still open (in office, or leave with no end date).
  endsAt   DateTime?
  kind     ServiceKind
  /// Verbatim reason from the source: "Secretário de Estado",
  /// "LICENCA_SAUDE_ATE_120D". Display and audit only.
  reason   String?

  source      ImportSource
  /// Stable key for idempotent re-import, e.g. "camara:hist:204379:2019-02-01".
  externalRef String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef])
  @@index([agentId, startsAt])
}

/// Raw, per-year measurements behind the quality index.
///
/// Deliberately stores counts rather than scores. Every input the index needs is
/// then a column, so re-tuning weights or band cut points is a recompute with no
/// network (`npm run requality`) — the same property that makes
/// `scripts/reprioritize.ts` possible for `Theme.priority`. It is also what lets
/// any published figure be defended document by document.
model AgentMetrics {
  id String @id @default(cuid())

  agentId String
  agent   PublicAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Calendar year the measurements cover.
  year    Int

  /// Roll calls held by the agent's house inside an EXERCISE stretch and outside
  /// any LEAVE — the attendance denominator.
  rollCallsEligible Int @default(0)
  rollCallsAttended Int @default(0)
  daysInExercise    Int @default(0)
  daysOnLeave       Int @default(0)

  /// Substantive bills only (PL/PEC/PLP/PDL) — requerimentos are excluded on
  /// purpose: one sampled deputy filed 31 of them against 4 bills in a year, so
  /// counting them would rank who fills the order paper.
  billsAuthored     Int @default(0)
  /// Of those, the ones that got somewhere (passed the house, became law,
  /// awaiting sanction). Counted again on top of `billsAuthored`, so outcome is
  /// worth double.
  billsAdvanced     Int @default(0)
  billsRapporteured Int @default(0)

  /// Parliamentary quota spent (CEAP / CEAPS), net of glosa. The running cost of
  /// the mandate — office, travel, fuel, publicity, security. NOT emendas
  /// parlamentares: money an agent secures for public policy is not an expense
  /// of theirs (CLAUDE.md §3.3).
  quotaSpent      Decimal @default(0) @db.Decimal(12, 2)
  /// Reimbursement documents behind `quotaSpent`. Zero means "no data yet", not
  /// "spent nothing" — the guard that stops an unpublished month reading as
  /// perfect frugality.
  quotaDocuments  Int     @default(0)
  /// Spend per official category, for display: `{ "COMBUSTÍVEIS": 12345.67 }`.
  quotaByCategory Json?
  /// Legislature numbers this year belongs to. The Câmara's expense endpoint
  /// keys on `(idLegislatura, ano)` and an election year spans two.
  legislatures    Int[]

  source    ImportSource @default(MANUAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([agentId, year])
  @@index([year])
}

/// Citizen / voter. Minimal PII: only first/last name in clear (CLAUDE.md §5).
model User {
  id        String @id @default(cuid())
  kid       String @unique
  firstName String
  lastName  String

  cpfEncrypted String
  cpfHash      String @unique
  cpfPrefix    String

  /// Full birth date, encrypted (AES-256-GCM), readable only in memory.
  ///
  /// Stored because the vote challenge asks for the day, the month or the year
  /// — a challenge that could only ever ask for the year would repeat the same
  /// two digits forever. It is never displayed, never leaves the system, and in
  /// a leak it is unreadable, so the §5 promise ("nothing beyond the name")
  /// still holds.
  birthDateEncrypted    String?
  /// Birth YEAR in clear. Kept alongside the encrypted date because the age
  /// gate and the anonymized demographics need to be queryable in SQL, and a
  /// year alone does not identify a person.
  birthYear             Int?
  /// When the CPF was last confirmed against the official registry.
  cpfVerifiedAt         DateTime?
  /// Which registry answered (`infosimples`, `serpro`, `mock`). Audit trail:
  /// a citizen verified against the mock provider is not verified at all.
  cpfVerificationSource String?

  /// When the citizen gave the specific, highlighted consent to have their
  /// votes (an "opinião política" — sensitive data under LGPD art. 5º, II)
  /// processed. Stored because art. 8º, §2 puts the burden of proving consent
  /// on the controller: an unprovable consent is no consent. Null means the
  /// account predates the requirement or the consent was revoked.
  politicalConsentAt DateTime?

  // Bumped on each vote to invalidate cached alignment indexes.
  voteVersion Int @default(0)

  votes          Vote[]
  socialAccounts SocialAccount[]
  follows        AgentFollow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A social identity bound to a citizen.
///
/// Rows are only ever written once a CPF has been confirmed, so an abandoned
/// sign-up leaves nothing behind. Several rows may point at one User: linking
/// Google and Apple to the same CPF is the same citizen, not two.
///
/// `subject` is the provider's `sub` claim — an internal dedup key exactly like
/// `externalRef` on imported records, and never exposed (CLAUDE.md §5). No
/// e-mail is stored: the provider hands one over, and keeping it would put a
/// second identifier beyond the name into a leak.
model SocialAccount {
  id       String         @id @default(cuid())
  provider SocialProvider
  /// Provider-scoped `sub`. Opaque and stable per (provider, app).
  subject  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, subject])
  @@index([userId])
}

/// A citizen declaring that a public agent represents them ("acompanhar").
///
/// The ballot is secret, so the platform can never ask who somebody voted for —
/// and without that, the index the whole product exists to publish is missing
/// its denominator: does this agent represent the people who elected them?
/// Following is the honest analogue. Instead of asserting a past vote, the
/// citizen declares, in the present and revocably, who represents them; the set
/// of followers is that agent's "base", and the base is what
/// `agentBaseAlignments()` measures the agent against.
///
/// **One follow per office**, because that is how the ballot works: a citizen
/// elects one federal deputy, one senator, one governor. `type` is copied from
/// the agent at follow time for exactly one reason — it puts that rule inside
/// the database (`@@unique([userId, type])`) instead of trusting every call
/// site to check first. Two tabs confirming at once therefore collide on the
/// constraint, which `followAgent` catches and answers in the same words as the
/// check it ran before writing.
///
/// **No `kid`.** Like `Vote`, a follow is never addressed from outside: it is
/// reached through the session plus the agent's kid (CLAUDE.md §5).
///
/// **Sensitivity.** The row ties a citizen to a declared political affiliation
/// — the same class of data as `Vote`, which already stores user + theme +
/// value in clear because the alignment index cannot be computed otherwise. The
/// §5 promise still holds: no CPF, no birth date, no e-mail lands here, and the
/// names of who follows whom are never published — only the total.
model AgentFollow {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentId String
  agent   PublicAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// The agent's office, copied at follow time. Denormalized so the "one per
  /// office" rule can live in the unique index below.
  type AgentType

  createdAt DateTime @default(now())

  @@unique([userId, type])
  @@index([agentId])
  @@index([userId])
}

/// Backend administrator (separate auth from citizens).
model Administrator {
  id           String       @id @default(cuid())
  kid          String       @unique
  firstName    String
  lastName     String
  email        String       @unique
  mobile       String?
  passwordHash String
  role         AdminRole    @default(EDITOR)
  imageUrl     String?
  status       EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// History log: one row per import execution, successful or not.
model ImportRun {
  id            String       @id @default(cuid())
  source        ImportSource
  /// Registered job name that produced this run, e.g. "camara:votes"
  /// (null for legacy/ad-hoc runs).
  job           String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  itemsSeen     Int          @default(0)
  itemsUpserted Int          @default(0)
  ok            Boolean      @default(false)
  note          String?

  @@index([source])
  @@index([job, startedAt])
}

/// Current state of one scheduled sync job. Doubles as a single-flight lock so
/// two worker instances (or a worker plus a manual trigger) never run the same
/// job concurrently: a run claims the job by setting `runningSince`, and a stale
/// claim older than the lease is reclaimable (see `src/lib/integration/runner.ts`).
model SyncJob {
  id                String    @id @default(cuid())
  /// Registered job name, e.g. "camara:agents".
  name              String    @unique
  /// Set while a run holds the lock; null when idle.
  runningSince      DateTime?
  lastStartedAt     DateTime?
  lastFinishedAt    DateTime?
  lastOk            Boolean   @default(false)
  lastNote          String?
  lastItemsSeen     Int       @default(0)
  lastItemsUpserted Int       @default(0)
  /// Resume cursor for incremental jobs (e.g. the last synced date).
  watermark         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
