# ─────────────────────────────────────────────────────────────────────────────
# Votto environment variables. Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (matches docker-compose.yml).
DATABASE_URL="postgresql://votto:votto@localhost:5432/votto?schema=public"

# Redis (alignment-index cache). Optional — app degrades gracefully if absent.
REDIS_URL="redis://localhost:6379"

# Session signing secret (JWT via jose). Generate: `openssl rand -base64 48`.
AUTH_SECRET="change-me-to-a-long-random-string"

# CPF encryption (AES-256-GCM). MUST be 32 bytes, base64. Generate: `openssl rand -base64 32`.
CPF_ENC_KEY="change-me-32-byte-base64-key===================="

# CPF HMAC key (deterministic hash for one-vote-per-CPF). Generate: `openssl rand -base64 48`.
CPF_HMAC_KEY="change-me-to-a-long-random-string"

# Anthropic API (article -> theme summary enrichment). Optional — enrichment is
# skipped gracefully when absent.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
# Cheap model for the per-theme plain-language summaries (hundreds per import).
ANTHROPIC_SUMMARY_MODEL="claude-haiku-4-5"

# ── Citizen auth — login social (Apple, Google, Meta) ────────────────────────
# Citizens sign in with a social provider and then confirm their CPF against the
# official registry (below). gov.br would be the better door — it hands over a
# CPF it has already verified — but Login Único is granted only to public bodies
# on .gov.br domains, so it is not available to Votto.
#
# In dev, keep SOCIAL_MODE=mock: the simulator at /dev-idp stands in for every
# provider, so the whole flow runs without registering an app anywhere.
#
# Click-by-click setup for all three consoles, with every URL:
#   docs/login-social-passo-a-passo.md
SOCIAL_MODE="mock"

# Each provider's callback is derived from APP_URL and must be registered there
# EXACTLY as printed below (a trailing slash is a different URL to all of them):
#   {APP_URL}/api/auth/social/google/callback
#   {APP_URL}/api/auth/social/apple/callback
#   {APP_URL}/api/auth/social/facebook/callback

# Google — console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID → Web application.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple — developer.apple.com (paid account required).
#   APPLE_CLIENT_ID  the **Services ID** (e.g. online.votto.web), NOT the App ID
#   APPLE_TEAM_ID    Membership → Team ID
#   APPLE_KEY_ID     Keys → the key with "Sign in with Apple" enabled
#   APPLE_PRIVATE_KEY  contents of the downloaded .p8 (one line, \n escapes ok)
# Apple posts its callback cross-site (response_mode=form_post), so the flow
# cookies are SameSite=None and the callback URL MUST be https — Apple rejects
# http even on localhost. Use a tunnel to test it locally.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Meta — developers.facebook.com → your app → Facebook Login.
# There is no separate Instagram credential: the Instagram button runs the
# Facebook Login flow. Meta shut off the Instagram Basic Display API on
# 2024-12-04, and its replacement serves only Business/Creator accounts.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── CPF validation (official registry) ──────────────────────────────────────
# Validates a citizen's CPF + birth date against the Receita Federal registry.
#   mock         accepts any well-formed CPF (dev only)
#   infosimples  automates Receita's public portal per request — cheapest, no
#                contract, but no availability guarantee
#   serpro       the official contracted channel — requires an e-CNPJ
#
# Before adding any other provider, apply this test: it must require the birth
# date as *input*. A service that returns a name (or a birth date) from the CPF
# alone cannot be querying the official portal, because the portal demands the
# birth date to answer — so it is reading from a stored base. See
# docs/integracao.md.
CPF_VALIDATION_PROVIDER="mock"

# Infosimples — token from https://api.infosimples.com/administracao/tokens
INFOSIMPLES_TOKEN=""

# Serpro — contracted at loja.serpro.gov.br (e-CNPJ required).
SERPRO_CPF_CONSUMER_KEY=""
SERPRO_CPF_CONSUMER_SECRET=""
# The trial dataset answers only for fictitious CPFs. Set to "false" once the
# production credentials are in place.
SERPRO_CPF_TRIAL="true"

# Shared secret for POST /api/cron/{job} (external scheduler / manual trigger).
# Leave empty to disable the endpoint. Generate: `openssl rand -base64 32`.
CRON_SECRET=""

# Public base URL.
APP_URL="http://localhost:3100"

# Google Analytics 4 — measurement id of the web stream (Admin → Fluxos de dados).
# Empty (the default) renders no analytics script at all. Only the public site is
# measured: admin, /embed widgets and /dev-idp never load it.
#
# In PRODUCTION this is not read from here: docker-compose.prod.yml declares it,
# because a measurement id is public and belongs in git — that keeps deploys
# push-only. Set it here only to exercise analytics in development.
GA_MEASUREMENT_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# Production only (docker-compose.prod.yml). Copy this file to .env.production.
# In production, DATABASE_URL and REDIS_URL above are overridden by compose to
# point at the bundled `db` and `redis` services — you only set the password.
# For votto.online, also set (above) APP_URL — every social callback URL is
# derived from it, so getting it wrong breaks all three providers at once:
#   APP_URL="https://votto.online"
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER="votto"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="votto"
# Domain for automatic HTTPS via Caddy (leave empty to serve on IP:3000).
DOMAIN="votto.online"
